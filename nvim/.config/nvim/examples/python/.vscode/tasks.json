{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python tests",
      "type": "process",
      "command": "${input:python}",
      "args": [
        "-m",
        "pytest"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    }
  ],
  "inputs": [
    {
      "id": "python",
      "type": "promptString",
      "description": "Project Python interpreter",
      "default": "python"
    }
  ]
}
