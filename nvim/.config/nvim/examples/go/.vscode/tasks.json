{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Go build",
      "type": "process",
      "command": "go",
      "args": [
        "build",
        "./..."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Go tests",
      "type": "process",
      "command": "go",
      "args": [
        "test",
        "./..."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Go clean",
      "type": "process",
      "command": "go",
      "args": [
        "clean",
        "./..."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
